# Writes build_info.hpp: the commit this build is from, and whether tracked files
# were clean. Run at every build (note 004); the file is rewritten only when its
# content changes, so an unchanged tree does not trigger recompiles.
execute_process(COMMAND git -C ${SRC} rev-parse HEAD
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  set(commit "")
endif()
execute_process(COMMAND git -C ${SRC} status --porcelain --untracked-files=no
                OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc2)
if(rc EQUAL 0 AND rc2 EQUAL 0 AND changes STREQUAL "")
  set(clean true)
else()
  set(clean false)
endif()
set(content "// Generated by cmake/build_info.cmake at build time. Do not edit.
#pragma once
#define LFIPC_GIT_COMMIT \"${commit}\"
#define LFIPC_GIT_CLEAN ${clean}
#define LFIPC_BUILD_TYPE \"${BUILD_TYPE}\"
#define LFIPC_BUILD_FLAGS \"${FLAGS}\"
")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE ${OUT} "${content}")
endif()
